# ==========================================
# POCKETTRADE BACKEND CONFIGURATION
# ==========================================

# Application Settings
APP_NAME=pockettrade-backend
APP_PORT=4000
PORT=4000
NODE_ENV=development
COMPANY_NAME="Pocket Trade"

# Web App URLs & Origins
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:5000
# Comma-separated list of additional allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://localhost:5173
# Production cookie domain (e.g. .yourdomain.com). In local development, leave blank.
COOKIE_DOMAIN=

# Admin Initial Seed Credentials
ADMIN_SEED_EMAIL=admin@pockettrade.com
ADMIN_SEED_PASSWORD=ChangeThisSecurePassword123!

# Database (PostgreSQL)
# Option A: Full Connection URI (e.g., Neon, Supabase, Render, Railway)
# DATABASE_URL=postgres://postgres:password@localhost:5432/pockettrade?sslmode=require
# Option B: Discrete Parameters
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_DATABASE=pockettrade
DB_SSL=false

# JWT Secrets & Expiry (Use random 64+ char strings for production)
AUTH_SECRET=generate_a_long_random_auth_secret_here
ACCESS_TOKEN=generate_a_long_random_access_token_secret_here
REFRESH_TOKEN=generate_a_long_random_refresh_token_secret_here
ACCESS_TOKEN_EXPIRES_IN=1d
REFRESH_TOKEN_EXPIRES_IN=30d

# Redis / BullMQ Queues (Optional for local dev, queues fall back safely in-process)
# QUEUE_REDIS_URL=rediss://default:token@host:6379
# or discrete:
QUEUE_REDIS_URL=
QUEUE_REDIS_PORT=6379
QUEUE_REDIS_PASSWORD=

# Email Delivery (Resend API)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM="Pocket Trade <notifications@yourdomain.com>"
GMAIL_USER=
GMAIL_PASSWORD=

# Cloudflare R2 Storage (Optional for local dev, guards prevent startup crash)
R2_ACCOUNT_ID=
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_CDN_URL=
R2_PUBLIC_URL=

# Market Data API Keys
FINNHUB_API_KEY=
TWELVE_DATA_API_KEY=

